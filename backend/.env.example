# Sao chép file này thành ".env" và điền giá trị thật trước khi chạy
# (Trên Vercel thì không dùng file .env — khai báo từng biến ở Settings → Environment Variables)

# Cổng chạy server khi chạy local. Trên Vercel không cần biến này.
PORT=3000

# Chuỗi bí mật dùng để ký JWT - PHẢI thay bằng chuỗi ngẫu nhiên dài, giữ bí mật
# Tạo nhanh bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_the_bang_chuoi_bi_mat_ngau_nhien_cua_ban

# --- Database Supabase (PostgreSQL) ---
# Lấy tại Supabase → Project Settings → Database → Connection string
# BẮT BUỘC chọn tab "Transaction pooler" (cổng 6543), KHÔNG dùng "Direct connection" (5432).
# Lý do: Vercel chạy serverless, mỗi request có thể mở một kết nối mới — dùng direct
# connection sẽ nhanh chóng cạn giới hạn kết nối của Supabase và app bắt đầu lỗi.
# Nhớ thay [YOUR-PASSWORD] bằng mật khẩu database thật.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Tài khoản admin mặc định, chỉ được tạo nếu chưa có admin nào trong database
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=ChangeMe123!
